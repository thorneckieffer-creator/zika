{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null",
        "study_state": {
          ".validate": "!data.exists() || newData.child('synced_at').val() > data.child('synced_at').val()"
        }
      }
    },
    "joins": {
      "$code": {
        ".validate": "$code.matches(/^[a-z2-9]{8}$/) && newData.hasChildren(['uid', 'name', 'at'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "ans": {
          ".validate": "newData.hasChildren(['owner'])",
          "owner": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && !data.exists() && data.parent().child('uid').exists() && data.parent().child('at').val() + 600000 > now && newData.child('owner').val() === auth.uid && newData.parent().parent().parent().child('users').child(auth.uid).child('devices').child(data.parent().child('uid').val()).exists()"
        },
        "$other": {
          ".validate": false
        },
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().child('users').child(auth.uid).child('joining').val() === $code) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || data.child('ans').child('owner').val() === auth.uid || data.child('at').val() + 900000 < now)))"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('devices').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid && !newData.exists() && (!data.child('joining').exists() || !newData.parent().parent().child('joins').child(data.child('joining').val()).exists())",
        "rec": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('devices').child(auth.uid).exists())",
          ".validate": "newData.hasChildren()",
          ".indexOn": [
            "m"
          ],
          "$key": {
            ".validate": "$key.length <= 500 && newData.child('m').val() === now && newData.child('h').isString() && newData.child('j').exists() !== newData.child('d').exists() && (!data.exists() || newData.child('h').val() >= data.child('h').val())",
            "h": {
              ".validate": "newData.isString() && newData.val().length < 64 && newData.val().matches(/^[0-9a-z]{12}[0-9A-Za-z_-]+$/)"
            },
            "m": {
              ".validate": "newData.isNumber()"
            },
            "j": {
              ".validate": "newData.isString() && newData.val().length <= 100000"
            },
            "d": {
              ".validate": "newData.val() === 1"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "meta": {
          "v": {
            ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('devices').child(auth.uid).exists()) && newData.exists()",
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
          },
          "migration": {
            ".validate": "newData.hasChildren(['state'])",
            "state": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "from": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "src_at": {
              ".validate": "newData.isNumber()"
            },
            "records": {
              ".validate": "newData.isNumber()"
            },
            "started": {
              ".validate": "newData.isNumber()"
            },
            "finished": {
              ".validate": "newData.isNumber()"
            },
            "device": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && auth.uid === $uid"
          },
          "$other": {
            ".validate": false
          }
        },
        "profile": {
          ".validate": "newData.hasChildren()",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "since": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && auth.uid === $uid"
        },
        "devices": {
          "$dev": {
            ".validate": "$dev.length <= 128 && newData.hasChildren(['name', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "seen": {
              ".write": "auth != null && auth.uid === $dev && data.parent().exists()",
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $dev && !newData.exists()))"
          }
        },
        "joining": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || !newData.parent().parent().parent().child('joins').child(data.val()).exists())",
          ".validate": "newData.isString() && newData.val().matches(/^[a-z2-9]{8}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
